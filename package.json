{
  "name": "twa-standards",
  "version": "1.2.0",
  "description": "Tomorrow We Are foundations, components and optional Specimen patterns.",
  "type": "module",
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./src/components.js",
    "./foundations.css": "./src/foundations.css",
    "./components.css": "./src/components.css",
    "./counter": "./src/counter.js",
    "./patterns": "./src/patterns/index.js",
    "./patterns/*": "./src/patterns/*",
    "./package.json": "./package.json",
    "./fonts.css": "./src/fonts.css"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && node scripts/serve.mjs",
    "test": "node test/site.mjs && node test/navigation.mjs && node test/fonts.mjs && node test/presentation.mjs",
    "deploy": "node scripts/deploy.cjs",
    "test:deploy": "node test/deploy.cjs",
    "references:capture": "node scripts/capture-references.mjs"
  },
  "dependencies": {
    "number-flow": "0.6.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "wrangler": "4.129.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnushGopalakrishnan/twa-standards.git"
  }
}
